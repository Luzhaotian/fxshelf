{
  "name": "@fxshelf/swarm-cursors",
  "version": "0.1.0",
  "description": "Multi-cursor swarm page builder for React — workers draw the scene as you scroll. Zero animation-lib deps. Copy-as-source friendly.",
  "license": "MIT",
  "author": "Lu Zhaotian",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/swarm-cursors.iife.js",
  "jsdelivr": "./dist/swarm-cursors.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "src/core",
    "src/react",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "SOURCE.md",
    "docs/使用说明.md",
    "docs/动效说明-专业.md",
    "docs/动效说明-大白话.md",
    "docs/CDN示例.html"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "keywords": [
    "fxshelf",
    "react",
    "swarm",
    "cursors",
    "blueprint",
    "page-builder",
    "animation",
    "effect"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luzhaotian/fxshelf.git",
    "directory": "packages/swarm-cursors"
  },
  "bugs": {
    "url": "https://github.com/Luzhaotian/fxshelf/issues"
  },
  "homepage": "https://github.com/Luzhaotian/fxshelf/tree/main/packages/swarm-cursors#readme"
}
